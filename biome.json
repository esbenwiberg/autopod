{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "off"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "maxSize": 2097152,
    "includes": [
      "**",
      "!**/packages/desktop/Sources/AutopodUI/Resources/Village/renderer",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.pnpm-store",
      "!**/pnpm-lock.yaml",
      "!**/.autopod-data",
      "!**/.agentry",
      "!**/.claude/worktrees",
      "!**/.clawpatch/project.json",
      "!**/.clawpatch/features",
      "!**/.clawpatch/findings",
      "!**/.speclint-cache",
      "!**/packages/desktop/.build",
      "!**/packages/desktop/build",
      "!**/packages/desktop/build-preview",
      "!**/tmp"
    ]
  }
}
