FROM node:24.18.0-slim

ARG CODEX_VERSION=0.160.1
ARG REPOSITORY_URL
ARG BASE_REVISION

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git python3 ripgrep \
      build-essential libcurl4-openssl-dev libexpat1-dev libssl-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Keep Git integration capabilities independent of the distribution package version.
COPY templates/base/install-worker-git.sh /tmp/install-worker-git.sh
RUN sh /tmp/install-worker-git.sh && rm /tmp/install-worker-git.sh
COPY templates/base/check-worker-git.sh /usr/local/bin/autopod-check-git
# Bounded workers must not acquire untracked background Git writers.
RUN chmod 0755 /usr/local/bin/autopod-check-git \
    && mkdir -p /usr/local/etc \
    && git config --system maintenance.auto false \
    && git config --system gc.auto 0

RUN userdel --remove node 2>/dev/null; groupdel node 2>/dev/null; \
    groupadd --gid 1000 autopod \
    && useradd --uid 1000 --gid autopod --shell /bin/sh --create-home autopod \
    && mkdir -p /output /repositories /opt/autopod-managed/portfolio-simulation \
    && chown autopod:autopod /output

RUN npm install -g "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force \
    && codex exec --help >/dev/null

WORKDIR /opt/autopod-managed/portfolio-simulation
ADD source.tar ./
LABEL org.opencontainers.image.source="${REPOSITORY_URL}" \
      org.opencontainers.image.revision="${BASE_REVISION}"
RUN test -n "${REPOSITORY_URL}" \
    && printf '%s' "${BASE_REVISION}" | grep -Eq '^[a-f0-9]{40}$' \
    && npm ci \
    && npm run build:smoke \
    && rm -rf .git dist \
    && chown -R root:root /opt/autopod-managed/portfolio-simulation \
    && chmod -R go-w /opt/autopod-managed/portfolio-simulation

ENV DISABLE_AUTOUPDATER=1
WORKDIR /output
USER autopod
RUN autopod-check-git
CMD ["sleep", "infinity"]
