FROM node:22.19.0-slim

ARG CODEX_VERSION=0.144.4
ARG REPOSITORY_URL
ARG BASE_REVISION

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN userdel --remove node 2>/dev/null; groupdel node 2>/dev/null; \
    groupadd --gid 1000 autopod \
    && useradd --uid 1000 --gid autopod --shell /bin/sh --create-home autopod \
    && mkdir -p /output /repositories /opt/autopod-managed/portfolio-simulation \
    && chown autopod:autopod /output

RUN npm install -g "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force \
    && codex exec --help >/dev/null

WORKDIR /opt/autopod-managed/portfolio-simulation
RUN test -n "${REPOSITORY_URL}" \
    && printf '%s' "${BASE_REVISION}" | grep -Eq '^[a-f0-9]{40}$' \
    && git init --quiet \
    && git remote add source "${REPOSITORY_URL}" \
    && git fetch --quiet --depth 1 source "${BASE_REVISION}" \
    && git checkout --quiet --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${BASE_REVISION}" \
    && npm ci \
    && npm run build:smoke \
    && rm -rf .git dist \
    && chown -R root:root /opt/autopod-managed/portfolio-simulation \
    && chmod -R go-w /opt/autopod-managed/portfolio-simulation

ENV DISABLE_AUTOUPDATER=1
WORKDIR /output
USER autopod
CMD ["sleep", "infinity"]
