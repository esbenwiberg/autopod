FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 git iptables libcap2-bin ca-certificates curl dnsmasq haproxy \
    build-essential libcurl4-openssl-dev libexpat1-dev libssl-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Keep Git integration capabilities independent of the distribution package version.
COPY templates/base/install-worker-git.sh /tmp/install-worker-git.sh
RUN sh /tmp/install-worker-git.sh && rm /tmp/install-worker-git.sh
COPY templates/base/check-worker-git.sh /usr/local/bin/autopod-check-git
# Bounded workers must not acquire untracked background Git writers.
RUN chmod 0755 /usr/local/bin/autopod-check-git \
    && mkdir -p /usr/local/etc \
    && git config --system maintenance.auto false \
    && git config --system gc.auto 0
RUN usermod -l autopod node && groupmod -n autopod node \
    && usermod -d /home/autopod -m autopod
RUN npm install -g @openai/codex@0.160.1
USER autopod
RUN autopod-check-git
WORKDIR /home/autopod
CMD ["sleep", "infinity"]
