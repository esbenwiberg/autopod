FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 git iptables libcap2-bin ca-certificates curl dnsmasq haproxy \
    && rm -rf /var/lib/apt/lists/*
RUN usermod -l autopod node && groupmod -n autopod node \
    && usermod -d /home/autopod -m autopod
RUN npm install -g @openai/codex@0.160.1
USER autopod
WORKDIR /home/autopod
CMD ["sleep", "infinity"]
