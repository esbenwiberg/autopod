+      expect(resumes).toBe(0);
+      expect(localStorage.getItem(key)).toBeNull();
+      await click(
+        stage === 'codex_interruption'
+          ? 'Resume task'
+          : stage === 'validation'
+            ? 'Resume validation'
+            : stage === 'worker'
+              ? 'Rework worker'
+              : 'Resume sandbox startup',
