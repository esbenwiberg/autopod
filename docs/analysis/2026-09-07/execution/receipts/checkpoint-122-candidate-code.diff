+    const row = db
+      .prepare(
+        `SELECT ${scanDecisionProjection}, r.pod_id AS repair_pod_id FROM scheduled_scan_triage t LEFT JOIN scheduled_scan_repairs r ON r.selection_id = t.id WHERE t.report_id = ? AND t.id = ?`,
+      )
