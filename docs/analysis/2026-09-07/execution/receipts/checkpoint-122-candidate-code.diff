+      expect(globalThis.fetch).toHaveBeenCalledWith(
+        expect.stringContaining(
+          stage === 'validation' ? '/retry-state' : `/retry-state?stage=${stage}`,
+        ),
+        expect.anything(),
+      );
+      expect(container.textContent).toContain('3 executed / 4 admitted');
+      if (stage === 'worker') {
