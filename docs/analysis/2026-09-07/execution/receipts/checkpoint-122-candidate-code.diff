+        VALUES ('original', 'test-profile', 'validate', 'validating', 'model', 'codex', 'branch', 'user')`).run();
+        runMigrations(db, migrations, logger);
+        const receipt = createValidationEvidenceCache(db).record('original', 'test', identity, {
