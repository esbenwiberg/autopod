+
+it.each([false, true])(
+  'shows duration coverage including missing completed records (legacy daemon: %s)',
+  async (legacy) => {
+    const state = {
+      taskId: 'task',
+      stage: 'worker',
+      admissionCount: 1,
+      executedCount: 1,
+      transientRetryCount: 0,
+      backoffsMs: [],
+      measuredDurationMs: legacy ? 0 : null,
+      interruptedCount: 0,
+      latest: { id: 'old', outcome: 'pass' },
+      authorizations: [],
+      telemetry: 'partial',
+      ...(!legacy
