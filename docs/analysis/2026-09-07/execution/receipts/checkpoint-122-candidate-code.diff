+    );
+    expect(() => nudges.acknowledgeDelivery('worker', first.deliveryId)).toThrow('storage fault');
+    expect(
+      db.prepare('SELECT COUNT(*) AS count FROM operator_guidance_acknowledgments').get(),
+    ).toEqual({ count: 0 });
