{
  "name": "autopod",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "village:update": "node scripts/update-village-renderer.mjs",
    "village:check": "node scripts/update-village-renderer.mjs --check",
    "build": "turbo run build",
    "test": "turbo run test && node --test scripts/*.test.mjs && bash scripts/deploy-hosted-daemon.test.sh && bash scripts/cleanup-hosted-daemon.test.sh",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format:check": "biome format .",
    "lint:fix": "biome check --write .",
    "arch": "depcruise --config .dependency-cruiser.cjs packages",
    "deadcode": "knip",
    "audit": "pnpm audit --audit-level high",
    "secret-scan": "node scripts/secret-scan.mjs",
    "predev": "turbo run build --filter @autopod/mobile-web --filter @autopod/cli",
    "dev": "turbo run dev",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "dependency-cruiser": "^17.0.0",
    "esbuild": "0.28.1",
    "knip": "^6.26.0",
    "turbo": "^2.10.4",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@huggingface/transformers>sharp": "0.35.5",
      "onnxruntime-node>adm-zip": "0.6.1",
      "@azure/msal-node@2>uuid": "11.1.1",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "1.14.5",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "onnxruntime-node@1.24.3>global-agent": "4.1.3",
      "hono@>=4 <4.13.11": "4.13.11",
      "ip-address@>=10 <10.7.4": "10.7.4",
      "body-parser@>=2 <2.4.0": "2.4.0",
      "qs@>=6 <6.16.1": "6.16.1",
      "fast-uri@>=3 <3.1.9": "3.1.9",
      "fast-uri@>=4 <4.2.3": "4.2.3",
      "@azure/identity>@azure/msal-node": "7.1.2",
      "zod@>=4 <4.6.6": "4.6.7",
      "@hono/node-server@>=2 <2.1.3": "2.1.3"
    }
  }
}
