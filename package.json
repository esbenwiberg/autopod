{
  "name": "autopod",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test && bash scripts/deploy-hosted-daemon.test.sh && bash scripts/cleanup-hosted-daemon.test.sh",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format:check": "biome format .",
    "lint:fix": "biome check --write .",
    "arch": "depcruise --config .dependency-cruiser.cjs packages",
    "deadcode": "knip",
    "audit": "pnpm audit --audit-level high",
    "secret-scan": "node scripts/secret-scan.mjs",
    "predev": "turbo run build --filter @autopod/mobile-web --filter @autopod/cli",
    "dev": "turbo run dev",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "dependency-cruiser": "^17.0.0",
    "knip": "^6.26.0",
    "turbo": "^2.10.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@huggingface/transformers>sharp": "0.35.4",
      "onnxruntime-node>adm-zip": "0.6.0",
      "@azure/msal-node@2>uuid": "11.1.1",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1"
    }
  }
}
